{
  "name": "@shieldlabs-ai/vue",
  "version": "1.0.0",
  "description": "Vue 3 and Nuxt bindings for ShieldLabs device intelligence: a plugin that loads the agent once and composables that return a request ID with loading and error state.",
  "keywords": [
    "shieldlabs",
    "vue",
    "nuxt",
    "device-intelligence",
    "fraud-detection",
    "risk-score",
    "identification"
  ],
  "homepage": "https://docs.shieldlabs.ai",
  "bugs": {
    "url": "https://github.com/ShieldLabs-ai/shieldlabs-vue/issues",
    "email": "contact@shieldlabs.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldLabs-ai/shieldlabs-vue.git"
  },
  "license": "MIT",
  "author": "ShieldLabs Inc. <contact@shieldlabs.ai>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@shieldlabs-ai/js": "^1.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~3.2.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "~9.39.5",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "~6.4.3",
    "vitest": "~3.2.7",
    "vue": "~3.5.22"
  }
}
